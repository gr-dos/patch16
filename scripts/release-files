#!/bin/sh
#
# Make the files a patch16 release carries beside patch16.exe, in DIR:
#
#   libc16-V-src.tar.gz    the source of the libc16 release linked into
#                          patch16.exe (V and the release archive's SHA-256
#                          are the ones scripts/fetch-libc16 pins), made by
#                          git archive from libc16's tag vV
#   LICENSE-libc16.txt     libc16's MIT notice, from that release archive
#   GPL-2.0.txt            patch16's license (GNU patch 2.2's)
#   notes.md               where the source is, how to build it, the
#                          licenses, and the checksums, for the release
#                          description
#
# Run after make, which fetches the pinned libc16 release to build/libc16.
# patch16's own corresponding source is the release tag (GitHub's source
# archives of it): GNU patch 2.2 as adapted (src/), compat/, the Makefile
# and scripts/, LICENSES/ and docs/PROVENANCE.md.
#
# usage: scripts/release-files DIR          (patch16's version is VERSION)
#
# LIBC16_GIT, if set, is cloned instead of github.com/gr-dos/libc16.

set -eu

[ $# -eq 1 ] || { echo "usage: $0 DIR" >&2; exit 2; }
dir=$1
top=$(cd "$(dirname "$0")/.." && pwd)
version=$(cat "$top/VERSION")
lv=$(sed -n 's/^version=//p' "$top/scripts/fetch-libc16")
lsha=$(sed -n 's/^sha256=//p' "$top/scripts/fetch-libc16")
libc16=$top/build/libc16
git_url=${LIBC16_GIT:-https://github.com/gr-dos/libc16.git}

# the archive make unpacked is the pinned one
[ "$(cat "$libc16/.zip-sha256")" = "$lsha" ]
[ "$(cat "$libc16/VERSION")" = "$lv" ]

mkdir -p "$dir"
dir=$(cd "$dir" && pwd)
src=$dir/libc16-src.git
rm -rf "$src"
git clone -q --bare --depth 1 --branch "v$lv" "$git_url" "$src"
commit=$(git -C "$src" rev-parse "v$lv^{commit}")
[ "$(git -C "$src" show "$commit:VERSION")" = "$lv" ]
git -C "$src" archive --format=tar --prefix="libc16-$lv/" "$commit" |
    gzip -9n > "$dir/libc16-$lv-src.tar.gz"
rm -rf "$src"
tsha=$(sha256sum "$dir/libc16-$lv-src.tar.gz" | cut -d' ' -f1)

cp "$libc16/LICENSE" "$dir/LICENSE-libc16.txt"
cp "$top/LICENSES/GPL-2.0.txt" "$dir/GPL-2.0.txt"

cat > "$dir/notes.md" <<EOF
patch16 $version is GNU patch 2.2 for 16-bit MS-DOS, built with Open Watcom
C and linked with libc16 $lv, not Open Watcom's C library.

### Source

- **patch16:** the source for this release is tag \`v$version\` (the
  Source code archives below): GNU patch 2.2 as adapted (\`src/\`), the DOS
  code (\`compat/\`), the \`Makefile\` and \`scripts/\`, and the notices.
  \`docs/PROVENANCE.md\` lists what came from GNU patch and what changed.
- **libc16 $lv**, linked into \`patch16.exe\`: \`libc16-$lv-src.tar.gz\`,
  attached, is its source at tag
  [\`v$lv\`](https://github.com/gr-dos/libc16/tree/v$lv) (commit \`$commit\`).
  The build used its release archive
  [\`libc16-$lv.zip\`](https://github.com/gr-dos/libc16/releases/tag/v$lv).

### Building

\`make\` fetches \`libc16-$lv.zip\` (checked against the SHA-256 below) and
the Open Watcom snapshot it names, then builds \`patch16.exe\`; \`make test\`
runs the tests under DOSBox-X. \`scripts/check-link\` checks from the link
map, on every build, that \`patch16.exe\` contains only patch16's objects
and libc16's.

### Licenses

- patch16 (GNU patch 2.2 and the changes to it): GPL version 2 or any later
  version, \`GPL-2.0.txt\`.
- libc16: MIT, \`LICENSE-libc16.txt\`.

### Checksums (SHA-256)

\`\`\`
$lsha  libc16-$lv.zip
$tsha  libc16-$lv-src.tar.gz
$(cd "$top" && sha256sum patch16.exe)
\`\`\`
EOF
